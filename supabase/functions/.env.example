# Server-side secrets for the Edge Functions. These are NOT Vite variables:
# never put them in the app's .env and never prefix them with VITE_.
# Easiest way to set them: Supabase Dashboard -> Edge Functions -> Secrets.
# (Or copy this file to supabase/functions/.env, fill it in, then run
#  supabase secrets set --env-file supabase/functions/.env)

# ---- Email, FREE option: Brevo (https://www.brevo.com) -----------------
# 300 emails/day free. No domain needed: after signing up, add and verify
# one sender address (e.g. the alumni office's email) under
# Senders & IP -> Senders, then create a key under SMTP & API -> API keys.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=alumni.office@example.com
EMAIL_FROM_NAME=Asian College Alumni

# ---- Email, alternative: Resend (only works for other people if you own
#      and verify a domain) -- leave empty if you use Brevo ---------------
RESEND_API_KEY=
EMAIL_FROM="Asian College Alumni <alumni@your-verified-domain.edu.ph>"

# ---- Shared secret between the database trigger and email-notification --
# Any long random text; the SAME value goes into supabase/email_notifications.sql
WEBHOOK_SECRET=

# ---- SMS (Semaphore -- https://semaphore.co) -- optional, not free ------
SEMAPHORE_API_KEY=
SMS_SENDER_NAME=

# ---- Link shown in emails ----------------------------------------------
SITE_URL=https://your-alumni-site.example
